{
  "configProperties": {
    "userPrincipalNameSuffix": "@yourdomain.com",
    "sqldb_connection": "Data Source=<your-sql-server>.database.windows.net; Initial Catalog=<your-database>;",
    "rowsPerCycle": 500,
    "sendMailNotification": true,
    "mailNotificationTo": "<notification-mailbox>@yourdomain.com",
    "mailNotificationFrom": "<sender-mailbox>@yourdomain.com",
    "debug": true,
    "disableUsers": true,
    "maxRetirements": 500,
    "maxChanges": 500,
    "licenseGroups": "<group-object-id-1>,<group-object-id-2>"
  }
}
